{
  "name": "email-aliases",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:prepare && cf dev",
    "build": "pnpm db:prepare && cf build",
    "deploy": "pnpm db:prepare && cf deploy",
    "db:prepare": "node scripts/prepare-db.mjs",
    "db:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --persist-to .cloudflare/state --mode development",
    "check": "vp check && pnpm typecheck",
    "typecheck": "pnpm db:prepare && tsc --noEmit --runExternalCode",
    "test": "pnpm db:prepare && vp test run --project unit",
    "test:integration": "vp test run --project integration"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@hono/mcp": "^0.3.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.10.0",
    "reylo": "0.6.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.6",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@reylosql/sqlite": "0.6.0",
    "@types/node": "^24.0.0",
    "cf": "1.0.0-beta.24",
    "typescript": "7.1.0-beta",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2"
}
